# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ShareIt four-digit pairing / automatic discovery in production
# Local development uses memory when these are unset.
# Copy the REST URL and read/write token from your Upstash Redis database.
# Never prefix these server credentials with NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy SHAREIT_REDIS_REST_URL / SHAREIT_REDIS_REST_TOKEN names still work.

# Optional: comma-separated STUN URLs for direct WebRTC connectivity.
# Defaults to Google's public STUN service. Set empty for LAN-only candidates.
# STUN exchanges connection metadata only, never file contents.
NEXT_PUBLIC_SHAREIT_STUN_URLS=stun:stun.l.google.com:19302

# Tina CMS Configuration
# Get these from https://tina.io/docs/tina-cloud/
NEXT_PUBLIC_TINA_CLIENT_ID=your_tina_client_id
TINA_TOKEN=your_tina_token

# Optional: Email Service (for contact form)
# Example with Resend:
# RESEND_API_KEY=re_your_api_key
# CONTACT_EMAIL=your-email@example.com
